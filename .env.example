# Para testes no computador, copie este arquivo para .env.
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
# PostgreSQL fora do Docker (em sua máquina, host.docker.internal):
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=sistema_estoque_ti
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_AQUI
DB_SSL_MODE=Disable
# Alternativa ao conjunto DB_*: URL PostgreSQL fornecida pelo Render.
# Se usar DB_URL, deixe em branco o valor local em desenvolvimento.
DB_URL=
WEB_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SEED_DEMO_USERS=true
# Em Development, senhas vazias para contas ausentes usam 123456.
# Em Production, as 3 senhas são obrigatórias (mínimo 12 caracteres).
DEMO_ADMIN_PASSWORD=
DEMO_FUNCIONARIO_PASSWORD=
DEMO_VENDEDOR_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
